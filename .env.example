# 部落格後台（PRD-005 / PLN-007）。複製成 .env.local 後填入實際值；.env.local 不進版控。

# MongoDB 連線字串（例如 MongoDB Atlas）。文章存在 blogPosts collection，圖片存在 GridFS 的 blogImages bucket。
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority"
# 資料庫名稱，預設 wenling
MONGODB_DB="wenling"

# 後台登入密碼（/admin/login）。請用夠長的隨機密碼。
ADMIN_PASSWORD="change-me-to-a-long-random-password"
# 登入 cookie 的簽章金鑰，至少 32 字元。產生方式：openssl rand -base64 48
ADMIN_SESSION_SECRET="change-me-at-least-32-characters-long-secret"
